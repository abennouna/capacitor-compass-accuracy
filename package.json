{
  "name": "@abennouna/capacitor-compass-accuracy",
  "version": "0.0.1",
  "description": "A Capacitor plugin for Android to monitor the accuracy of the device compass.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "AbennounaCapacitorCompassAccuracy.podspec"
  ],
  "author": "Abdelaziz Bennouna (tellibus)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abennouna/capacitor-compass-accuracy.git"
  },
  "bugs": {
    "url": "https://github.com/abennouna/capacitor-compass-accuracy/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "compass",
    "accuracy",
    "android"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme AbennounaCapacitorCompassAccuracy -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CompassAccuracyPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/docgen": "0.3.1",
    "@capacitor/ios": "8.4.1",
    "@ionic/eslint-config": "0.4.0",
    "@ionic/prettier-config": "4.0.0",
    "@ionic/swiftlint-config": "2.0.0",
    "eslint": "8.57.1",
    "npm-check-updates": "22.2.9",
    "prettier": "3.9.5",
    "prettier-plugin-java": "2.10.2",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "swiftlint": "2.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
